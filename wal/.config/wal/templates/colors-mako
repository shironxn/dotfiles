# Mako notification daemon — pywal-themed
font=JetBrainsMono Nerd Font 11
background-color={background}
text-color={foreground}
border-size=1
border-color={color3}
border-radius=0
padding=10,14
margin=8
width=300
height=65
max-visible=5
anchor=top-right
default-timeout=3000
ignore-timeout=0
progress-color={color1}
icons=1
max-icon-size=22
icon-border-radius=0
markup=1
sort=-time
group-by=app-name
format=<b>%s</b>\n%b

[urgency=low]
default-timeout=2000
text-color={color8}

[urgency=normal]
default-timeout=3000
text-color={foreground}

[urgency=critical]
default-timeout=0
text-color={foreground}
border-color={color4}
