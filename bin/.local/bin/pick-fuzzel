#!/bin/sh
# dmenu-style wrapper around fuzzel.
#   pick-fuzzel <prompt> [extra fuzzel args...]
prompt="${1:-}"
[ $# -gt 0 ] && shift

# Pressing the same shortcut twice closes the picker; a different one replaces
# whatever is open instead of stacking a second window behind it.
if pgrep -x fuzzel >/dev/null 2>&1; then
  if [ -n "$prompt" ] && pkill -f "fuzzel.*-p +$prompt" 2>/dev/null; then
    exit 0
  fi
  pkill -x fuzzel 2>/dev/null || true
  sleep 0.05
fi

[ -n "$prompt" ] && set -- -p "$prompt" "$@"

exec fuzzel -d -i --minimal-lines "$@"
