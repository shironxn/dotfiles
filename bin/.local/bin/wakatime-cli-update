#!/usr/bin/env bash
# Keep the managed WakaTime CLI at the latest upstream release.
#
# vim-wakatime (the Neovim plugin) only installs wakatime-cli once: as soon as
# ~/.wakatime/wakatime-cli exists it stops touching it, so nothing ever updates
# it again. This script is the update path instead — run it from the
# wakatime-cli-update.timer user timer, or by hand.
#
# Idempotent: exits 0 without downloading anything when versions match.

set -euo pipefail

repo=wakatime/wakatime-cli
cli="${WAKATIME_CLI_PATH:-$HOME/.wakatime/wakatime-cli}"

# wakatime-cli rotates its own log once a run exceeds 25 MiB, but it leaves the
# rotated wakatime-<timestamp>.log files behind forever. While Pi runs, the
# transcript parser logs a warning per transcript line it cannot unmarshal, so
# those files pile up fast. Keep only the last day of them.
find "$HOME/.wakatime" -maxdepth 1 -name 'wakatime-*.log' -mtime +1 -delete 2>/dev/null || true

# wakatime-cli leaves one zero-byte juju-* lock file in the temp dir per sync
# run; nothing reuses them once the process exits.
find /tmp -maxdepth 1 -name 'juju-wakatime-*' -mtime +1 -delete 2>/dev/null || true

case "$(uname -m)" in
x86_64 | amd64) asset=wakatime-cli-linux-amd64.zip ;;
aarch64 | arm64) asset=wakatime-cli-linux-arm64.zip ;;
*)
	echo "unsupported architecture: $(uname -m)" >&2
	exit 1
	;;
esac

release_json=$(
	curl -fsSL --max-time 30 --retry 3 --retry-delay 5 "https://api.github.com/repos/$repo/releases/latest"
) || {
	# A daily timer on a flaky link should not leave a failed unit behind.
	echo "could not fetch the latest release, trying again on the next run" >&2
	exit 0
}
latest=$(printf '%s' "$release_json" | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1)
[ -n "$latest" ] || {
	echo "empty release tag, trying again on the next run" >&2
	exit 0
}

current=""
if [ -x "$cli" ]; then current=$("$cli" --version 2>/dev/null || true); fi

if [ "$current" = "$latest" ]; then
	echo "wakatime-cli is up to date ($current)"
	exit 0
fi

echo "updating wakatime-cli: ${current:-none} -> $latest"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

curl -fsSL --max-time 300 --retry 3 --retry-delay 5 -o "$tmp/$asset" \
	"https://github.com/$repo/releases/download/$latest/$asset"

if command -v bsdtar >/dev/null; then
	bsdtar -xf "$tmp/$asset" -C "$tmp"
else
	unzip -q "$tmp/$asset" -d "$tmp"
fi

binary=$(find "$tmp" -type f -name 'wakatime-cli*' ! -name '*.zip' -print -quit)
[ -n "$binary" ] || {
	echo "no binary inside $asset" >&2
	exit 1
}

# Atomic swap so a concurrent heartbeat never sees a half-written binary.
install -Dm755 "$binary" "$cli.new.$$"
mv -f "$cli.new.$$" "$cli"

echo "installed $("$cli" --version)"
