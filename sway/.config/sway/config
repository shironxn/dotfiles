# --- Variables ---
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu ~/.local/bin/menu-launcher

# Fallback palette, overridden by ~/.cache/wal/colors-sway when pywal has run.
set $color0 #1e1e2e
set $color1 #f38ba8
set $color2 #a6e3a1
set $color3 #f9e2af
set $color4 #89b4fa
set $color5 #cba6f7
set $color6 #94e2d5
set $color7 #cdd6f4
set $color8 #585b70
set $color9 #f38ba8
set $color10 #a6e3a1
set $color11 #f9e2af
set $color12 #89b4fa
set $color13 #cba6f7
set $color14 #94e2d5
set $color15 #cdd6f4
set $background #1e1e2e
set $foreground #cdd6f4

# Window titles & tab typography
font pango:JetBrainsMono Nerd Font 13

# --- Includes ---
include ~/.cache/wal/colors-sway
include ~/.config/sway/config.d/*.conf
include /etc/sway/config.d/*
include ~/.config/sway/host.conf
