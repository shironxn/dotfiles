fish/.config/fish/functions/
fish/.config/fish/completions/

# Local secrets (API keys, personal tokens)
fish/.config/fish/conf.d/secrets.fish

# Machine-specific Sway configuration
sway/.config/sway/host.conf

# Anything explicitly marked machine-local
*.local.conf
